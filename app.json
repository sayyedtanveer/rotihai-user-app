{
  "expo": {
    "name": "RotiHai",
    "slug": "rotihai-user",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/rotihai-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.rotihaiuser"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff3e2",
        "foregroundImage": "./assets/rotihai-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.rotihaiuser"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Allow RotiHai to find your delivery location."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf8f4",
          "image": "./assets/rotihai-launch.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#fbf8f4",
            "image": "./assets/rotihai-launch.png"
          }
        }
      ],
      "expo-font",
      "./plugins/withPaymentQueries.cjs",
      "./plugins/withWindowsCmakePaths.cjs",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow RotiHai to hear your craving when you tap Craving Buddy.",
          "speechRecognitionPermission": "Allow RotiHai to turn your craving into text."
        }
      ],
      "expo-dev-client"
    ]
  }
}
